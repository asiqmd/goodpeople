# Copy to .env. Local values for development only.

# A superuser connection, used only by `pnpm db:setup` to create roles and databases.
# Homebrew Postgres: your macOS user with no password. Docker Compose: postgres:postgres.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Owns the schema; runs migrations and seeds. Subject to row-level security like everyone else.
DATABASE_OWNER_URL=postgres://gp_owner:gp_owner_dev@localhost:5432/good_people
# What the API connects as: no BYPASSRLS, cannot create tables.
DATABASE_URL=postgres://gp_app:gp_app_dev@localhost:5432/good_people

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 random bytes, base64. Encrypts identity and account numbers. Never reuse across environments.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=1gcMplZrBNlkDF9hvs1wfaGAnc6Pe6Q8P+tbSOCaOUw=

# Web
API_URL=http://localhost:4000

# Seed data (local test accounts: every seeded user shares this password)
SEED_SUPER_ADMIN_EMAIL=superadmin@goodpeople.test
SEED_PASSWORD=GoodPeople!2026

# Documents: a local directory (relative to apps/api), or an S3-compatible bucket.
# Files are encrypted with FIELD_ENCRYPTION_KEY before they are stored either way.
STORAGE_DRIVER=local
STORAGE_DIR=storage
# STORAGE_DRIVER=s3
# S3_BUCKET=good-people-documents
# S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:9000   # MinIO; leave unset for AWS
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio-dev-password
# S3_FORCE_PATH_STYLE=true

# Chrome or Chromium for letters, ID cards and service books (PDF). Found automatically in
# the usual install locations; set it on servers.
# CHROME_PATH=/usr/bin/chromium

# Billing: where the payment gateways send customers back (this API, as the internet sees it).
# API_ORIGIN=https://api.goodpeople.example
# SSLCommerz (cards, internet banking): a gateway is offered only when its credentials are set.
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=on
# bKash tokenized checkout.
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# A gateway that takes no money, for trying payments locally. Never turn it on in production.
# BILLING_FAKE_GATEWAY=on
