# Copy to .env. Local values for development only.

# A superuser connection, used only by `pnpm db:setup` to create roles and databases.
# Homebrew Postgres: your macOS user with no password. Docker Compose: postgres:postgres.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Owns the schema; runs migrations and seeds. Subject to row-level security like everyone else.
DATABASE_OWNER_URL=postgres://gp_owner:gp_owner_dev@localhost:5432/good_people
# What the API connects as: no BYPASSRLS, cannot create tables.
DATABASE_URL=postgres://gp_app:gp_app_dev@localhost:5432/good_people

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 random bytes, base64. Encrypts identity and account numbers. Never reuse across environments.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=1gcMplZrBNlkDF9hvs1wfaGAnc6Pe6Q8P+tbSOCaOUw=

# Web
API_URL=http://localhost:4000

# Seed data (local test accounts: every seeded user shares this password)
SEED_SUPER_ADMIN_EMAIL=superadmin@goodpeople.test
SEED_PASSWORD=GoodPeople!2026
