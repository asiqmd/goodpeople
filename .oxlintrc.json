{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist",
    ".next",
    "apps/mobile",
    "**/migrations/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ]
  }
}
