# Good People production settings, for infra/docker-compose.prod.yml and infra/scripts/*.sh.
#
#   cp infra/.env.prod.example infra/.env && chmod 600 infra/.env
#
# git ignores infra/.env, and Docker Compose reads it automatically for this stack. Never commit
# real values, and never reuse them between environments (staging and production get their own).
#
# Format: KEY=value, one per line, no spaces around "=", comments on their own lines. Values
# are literal; quotes are only needed for values with spaces. Use hex passwords (openssl rand
# -hex 24) so they can go into the database URLs without escaping.

# ── Stack ──────────────────────────────────────────────────────────────────────────────────

# Which optional services to run: "db" runs PostgreSQL here (remove it for a managed
# database); add ",minio" to run MinIO as the document bucket. Example: db,minio
COMPOSE_PROFILES=db,redis

# Image names and tag. `docker compose build` tags what it builds with these; to deploy from a
# registry instead, set the full names (e.g. registry.example.com/good-people-api) and run
# `docker compose pull`. Use the release's Git tag or commit, so you can roll back.
GP_API_IMAGE=good-people-api
GP_WEB_IMAGE=good-people-web
GP_VERSION=latest

# ── Domains and TLS (Caddy) ────────────────────────────────────────────────────────────────

# The web app, and the API for the mobile app and the Edge Agents. Both need DNS records
# pointing at this server before the first start.
GP_DOMAIN=hr.example.com
GP_API_DOMAIN=api.hr.example.com
# Let's Encrypt account e-mail: expiry and problem notices go here.
ACME_EMAIL=ops@example.com

# ── PostgreSQL ─────────────────────────────────────────────────────────────────────────────

# Superuser password for the bundled PostgreSQL (profile "db"). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Superuser connection, used only by the one-off `setup` service to create roles and the
# database. Inside the stack the host is "postgres". Managed database: the provider's admin user.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@postgres:5432/postgres
# The schema owner (gp_owner): runs migrations. Subject to row-level security like everyone.
# Generate the password: openssl rand -hex 24
DATABASE_OWNER_URL=postgres://gp_owner:CHANGE_ME@postgres:5432/good_people
# What the API connects as (gp_app): no BYPASSRLS, cannot create tables. Its own password.
DATABASE_URL=postgres://gp_app:CHANGE_ME@postgres:5432/good_people

# ── API ────────────────────────────────────────────────────────────────────────────────────

# Signs access tokens (at least 32 characters). Generate: openssl rand -base64 48
# Changing it signs everyone out of their current access token (see the runbook).
JWT_ACCESS_SECRET=
# Access token lifetime in seconds, and refresh token lifetime in days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Encrypts every document and every identity and account number. Generate once:
#   openssl rand -base64 32
# BACK IT UP SEPARATELY from the database backups (password manager or vault). If it is lost,
# every document and identity number is lost with it. Never change it on a running system:
# there is no re-encryption job yet.
FIELD_ENCRYPTION_KEY=
# Two-step sign-in for workspace admins, HR admins and platform staff. Keep it on.
REQUIRE_ADMIN_MFA=on
# Background attendance processing interval in minutes.
ATTENDANCE_JOB_INTERVAL_MINUTES=15
# Logs are JSON lines; LOG_FORMAT=pretty gives Nest's readable lines. Levels: debug, info,
# warn, error. The OpenAPI pages (/docs) are off unless API_DOCS=on.
# LOG_FORMAT=json
# LOG_LEVEL=info
# API_DOCS=off
# Required: where new support tickets and customer replies are emailed (a shared inbox).
# Left empty, the API refuses to start.
SUPPORT_INBOX_EMAIL=
# The contact address in the public pages' footer.
GP_SUPPORT_EMAIL=
# What the status checks fetch to check the web app; inside this stack the web container.
STATUS_WEB_URL=http://web:3000/login

# ── Documents ──────────────────────────────────────────────────────────────────────────────

# "local": files in GP_DOCUMENTS_DIR on this server. "s3": an S3-compatible bucket.
# Either way the API encrypts each file before storing it.
STORAGE_DRIVER=local
# Host directory for the local store, mounted into the API. Create it owned by uid 1000:
#   sudo install -d -o 1000 -g 1000 -m 750 /srv/good-people/documents
GP_DOCUMENTS_DIR=/srv/good-people/documents

# For STORAGE_DRIVER=s3. With the "minio" profile, use S3_ENDPOINT=http://minio:9000 and
# S3_FORCE_PATH_STYLE=true; the access key and secret also become MinIO's root credentials
# (secret: at least 8 characters). For AWS, leave S3_ENDPOINT out.
# S3_BUCKET=good-people-documents
# S3_REGION=ap-south-1
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ── Notifications ──────────────────────────────────────────────────────────────────────────

# E-mail and SMS must really send: the API refuses to start with the "log" drivers, which
# only write messages (codes hidden) to the API log, unless ALLOW_LOG_SENDERS=on (staging only).
# E-mail: "smtp", e.g. smtp://user:password@smtp.example.com:587
EMAIL_DRIVER=smtp
SMTP_URL=
# EMAIL_FROM='Good People <no-reply@hr.example.com>'
# SMS (sign-in codes): "sslwireless". SSL Wireless usually allow-lists the sending IP.
SMS_DRIVER=sslwireless
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
# ALLOW_LOG_SENDERS=on
# Push to the mobile app: "log" or "fcm" (a Firebase service account). In FCM_PRIVATE_KEY,
# write line breaks as \n and wrap the value in single quotes.
# PUSH_DRIVER=fcm
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'

# ── Backups (infra/scripts/*.sh, run on this server's host) ────────────────────────────────

# Where backups go on this server, and how long to keep them. The newest BACKUP_KEEP_MIN are
# always kept, however old.
BACKUP_DIR=/srv/good-people/backups
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3
# The role pg_dump connects as. It must bypass row-level security (gp_owner cannot: its dump
# fails, or with --enable-row-security silently leaves out every workspace's rows). Create
# gp_backup as described in the runbook. From the host, the bundled database is 127.0.0.1.
BACKUP_DATABASE_URL=postgres://gp_backup:CHANGE_ME@127.0.0.1:5432/good_people
# Superuser connection from the host, for restore.sh and verify-backup.sh.
RESTORE_ADMIN_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# Optional: where verify-backup.sh records its drills, when it runs on another machine than
# backup.sh (defaults to BACKUP_DATABASE_URL).
# BACKUP_REPORT_DATABASE_URL=postgres://gp_backup:CHANGE_ME@db.example.com:5432/good_people
# Optional: an rsync destination off this server, updated after each backup.
# BACKUP_OFFSITE_RSYNC=backup@backup.example.com:/srv/good-people-backups/
# Optional, STORAGE_DRIVER=s3: the bucket's endpoint as seen from the host, when it differs
# from S3_ENDPOINT (MinIO in this stack: http://127.0.0.1:9000).
# BACKUP_S3_ENDPOINT=http://127.0.0.1:9000

# Shared security state; use a private Redis with durable AOF and no eviction.
SECURITY_STORE=redis
# Generate a hex password (openssl rand -hex 32). Use the same password in this URL.
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
SECURITY_NAMESPACE=gp:security:v1
JWT_ACCESS_KEY_ID=v1
# JWT_PREVIOUS_ACCESS_SECRET=
# JWT_PREVIOUS_KEY_ID=
# JWT_PREVIOUS_VALID_UNTIL=
OIDC_PRIVATE_HOSTS=

# M2 public integrations. APIs never schedule jobs; use BACKGROUND_JOBS=on pnpm worker.
PUBLIC_TOKEN_TTL_SECONDS=300
PUBLIC_RATE_LIMIT=120
PUBLIC_DAILY_QUOTA=20000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETENTION_DAYS=14
WEBHOOK_QUEUE_LIMIT=10000
JOB_LEASE_SECONDS=60
# Operator-approved exact receiver hostnames only; HTTPS required outside tests.
WEBHOOK_PRIVATE_HOSTS=
WORKER_CONCURRENCY=4
