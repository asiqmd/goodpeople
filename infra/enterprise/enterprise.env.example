# Customer-side compose settings. Images come only from signed images.env.
GP_STACK_NAME=good-people-enterprise
GP_OFFLINE=true
GP_WEB_HOST=people.customer.example
GP_API_HOST=people-api.customer.example
GP_SUPPORT_EMAIL=customer-operator@example.invalid
GP_APP_ENV_FILE=./config/app.env
GP_DATABASE_DIR=/srv/good-people/postgres
GP_REDIS_DIR=/srv/good-people/redis
GP_DOCUMENTS_DIR=/srv/good-people/documents
GP_PROXY_DATA_DIR=/srv/good-people/proxy-data
GP_PROXY_CONFIG_DIR=/srv/good-people/proxy-config
# Confirm these IDs from the selected immutable upstream image before qualification.
GP_POSTGRES_UID=999
GP_POSTGRES_GID=999
GP_REDIS_UID=999
GP_REDIS_GID=999
GP_DATABASE_PORT=5432
