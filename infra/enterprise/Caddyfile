{
  admin off
  auto_https disable_redirects
  http_port 8080
  https_port 8443
}
https://{$GP_WEB_HOST} {
  tls /run/tls/server.crt /run/tls/server.key
  encode gzip
  reverse_proxy web:3000
}
https://{$GP_API_HOST} {
  tls /run/tls/server.crt /run/tls/server.key
  @private path /docs /docs/*
  respond @private 404
  reverse_proxy api:4000
}
