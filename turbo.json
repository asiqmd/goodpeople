{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_OWNER_URL",
    "DATABASE_ADMIN_URL",
    "API_URL",
    "TEST_REDIS_URL",
    "SECURITY_STORE",
    "REDIS_URL",
    "SECURITY_NAMESPACE",
    "JWT_ACCESS_KEY_ID",
    "JWT_PREVIOUS_ACCESS_SECRET",
    "JWT_PREVIOUS_KEY_ID",
    "JWT_PREVIOUS_VALID_UNTIL",
    "OIDC_PRIVATE_HOSTS",
    "PROCESS_ROLE",
    "BACKGROUND_JOBS",
    "PUBLIC_TOKEN_TTL_SECONDS",
    "PUBLIC_RATE_LIMIT",
    "PUBLIC_DAILY_QUOTA",
    "WEBHOOK_PRIVATE_HOSTS",
    "WEBHOOK_MAX_ATTEMPTS",
    "WEBHOOK_RETENTION_DAYS",
    "WEBHOOK_QUEUE_LIMIT",
    "JOB_LEASE_SECONDS",
    "WORKER_CONCURRENCY",
    "DEPLOYMENT_MODE",
    "INSTALLATION_ID",
    "INSTALLATION_TENANT_ID",
    "LICENSE_PUBLIC_KEYS_JSON",
    "RELEASE_VERSION",
    "FIELD_ENCRYPTION_ACTIVE_KEY_ID",
    "FIELD_ENCRYPTION_KEYS_JSON",
    "GP_ENTERPRISE_DRILLS",
    "GP_ENTERPRISE_EVIDENCE_FILE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
